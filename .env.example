# Environment variables (SPEC §2). Copy to .env.local for development.
# Everything is optional in development: with nothing set you get PGlite in
# ./.data/pglite, local file storage, and the link/console messaging drivers.
# Variables marked (prod: required) must be set in production.

# ---------------------------------------------------------------- core
# Absolute public URL, used in links inside messages and magic links. (prod: required)
APP_URL=http://localhost:3000
# HMAC/encryption root secret, at least 16 chars (`openssl rand -base64 32`). (prod: required)
SESSION_SECRET=
# Bearer secret for /api/cron/tick; the route returns 503 without it in production. (prod: required)
CRON_SECRET=
# Optional separate key for encrypting secrets at rest (defaults to SESSION_SECRET).
DATA_KEY=
# Set to 1 to allow a non-Secure `sid` cookie over plain http (never in real production).
COOKIE_INSECURE=
# Which proxy hop gives the client IP (rate limits, audit): unset/1 = one proxy (Caddy,
# nginx, Vercel), 2.. = more, cloudflare = CF-Connecting-IP, x-real-ip, none/0. See DEPLOY.md.
# No reverse proxy in front (app exposed directly)? Set TRUST_PROXY=0: otherwise clients can
# spoof X-Forwarded-For and dodge per-IP rate limits.
TRUST_PROXY=

# ---------------------------------------------------------------- database
# Production Postgres 16+ (Neon, Supabase, VPS). If unset, embedded PGlite is used.
DATABASE_URL=
# PGlite data directory (development only). Default ./.data/pglite
PGLITE_DIR=
# Postgres only: run migrations on the first request (advisory-locked). Otherwise
# run `npm run db:migrate` at deploy time.
DB_MIGRATE_ON_BOOT=

# ---------------------------------------------------------------- storage (photos, receipts, signatures)
# local (default; files under UPLOADS_DIR) | s3 (any S3-compatible store, e.g. Cloudflare R2)
STORAGE_DRIVER=local
UPLOADS_DIR=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Presigned PUTs carry a signed x-amz-checksum-sha256 so the store refuses a cut-off or
# swapped file. Set to off only for a store that rejects that header (hashes are then
# recorded as unverified). Default: on.
S3_CHECKSUM=

# ---------------------------------------------------------------- messaging
# link (default: tap-to-send sms: links from the outbox) | console (log only)
# Later: android_gateway | twilio | telnyx
MESSAGING_SMS_DRIVER=link
# console (default; logs emails, incl. password-reset links) | resend
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------- web push (generate with `npm run gen:vapid`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# Same value as VAPID_PUBLIC_KEY, exposed to the browser for subscribing.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------- payments
# manual (default, always available) | stripe
PAYMENTS_DRIVER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Stripe API version pin.
STRIPE_API_VERSION=

# ---------------------------------------------------------------- AI (receipts, odometer photos; never on the money path)
# none (default) | gemini
AI_PROVIDER=none
GEMINI_API_KEY=
AI_MODEL_OCR=gemini-3.5-flash-lite
# free | paid. The free tier never receives PII.
AI_TIER=free
# Max AI calls per day.
AI_DAILY_BUDGET=20

# ---------------------------------------------------------------- maps & geocoding
# Tile server URL template + attribution. The OpenStreetMap default is for development only.
NEXT_PUBLIC_TILE_URL=
NEXT_PUBLIC_TILE_ATTRIBUTION=
# census (US, free, default) | nominatim (1 req/s) | none
GEOCODER=census
# Address autocomplete while staff type a street: photon (default; free, no key,
# OpenStreetMap data) | geoapify (needs GEOAPIFY_API_KEY) | none.
ADDRESS_AUTOCOMPLETE=photon
# The public Photon server (https://photon.komoot.io) throttles heavy use; point this at
# a self-hosted Photon for busy offices.
PHOTON_URL=
GEOAPIFY_API_KEY=

# ---------------------------------------------------------------- lead intake
# Optional Cloudflare Turnstile secret for the hosted lead form.
TURNSTILE_SECRET=

# ---------------------------------------------------------------- runtime switches
# 1 = don't run events/cron work in after() (tests, one-off scripts).
CRM_DISABLE_BACKGROUND=
# 0 = disable the once-a-minute cron piggy-back on signed-in requests.
CRON_PIGGYBACK=
# 1 = build a standalone server (Docker): `STANDALONE=1 npm run build`.
STANDALONE=
# 1 = serve the /dev/ui component gallery in production.
DEV_UI=
# Shown by /api/health (defaults to the Vercel commit SHA or "dev").
APP_VERSION=
